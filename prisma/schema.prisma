// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum productTypes {
  WEB
  FIVEM
  DISCORD_BOT
}

enum paymentTypes {
  COMPLETED
  PENDING
  NOT_COMPLETED
  CANCELED
}

enum payment_method_Types {
  PAYPAL
  STRIPE
  CRYPTO
}

enum permissionTypes {
  CREATE_USER
  READ_USER
  UPDATE_USER
  DELETE_USER
  READ_USER_DETAILS
  UPDATE_USER_DETAILS
  CREATE_PRODUCT
  READ_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  CREATE_PURCHASE
  READ_PURCHASE
  UPDATE_PURCHASE
  DELETE_PURCHASE
  CREATE_INVOICE
  READ_INVOICE
  UPDATE_INVOICE
  DELETE_INVOICE
  CREATE_BUDGET
  READ_BUDGET
  UPDATE_BUDGET
  DELETE_BUDGET
  READ_ADMIN_PANEL
  UPDATE_SETTINGS
  VIEW_REPORTS
  EXPORT_DATA
  ASSIGN_ROLE
  VIEW_ACTIVITY_LOG
  ALL_PERMISSION
}

enum statusTypes {
  ACTIVE
  INACTIVE
  PENDING
  COMPLETED
  CANCELED
}

enum roleTypes {
  USER
  TEAM
  ADMIN
  OWN
}

enum chargesTypes {
  DISCOUNT
  OTHER
  TAX
}

model users {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  role      roleTypes @default(USER)

  userdetails      userDetails?       @relation(references: [id], fields: [userdetailsId])
  userdetailsId    String?            @unique
  purchases        purchases[]
  budgets          budgets[]
  user_permissions user_permissions[]
  services_worke   services_worke[]
  invoices         invoices[]

  @@index([email])
}

model userDetails {
  id        String @id @default(uuid())
  firstname String
  lastname  String
  nickname  String
  zipcode   String
  address   String
  phone     String

  user users?

  updatedAT DateTime @updatedAt
}

model products {
  id          String       @id @default(uuid())
  name        String
  description String       @db.Text
  price       Float
  photo       String
  type        productTypes @default(WEB)

  createdAt          DateTime             @default(now())
  updatedAT          DateTime             @updatedAt
  purchases_products purchases_products[]
  budget_products    budget_products[]
  invoices_products  invoices_products[]
}

model purchases {
  id             String               @id @default(uuid())
  client         users                @relation(fields: [clientId], references: [id])
  clientId       String
  payment_method payment_method_Types @default(PAYPAL)
  payment_status paymentTypes         @default(NOT_COMPLETED)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  purchases_products purchases_products[]
}

model purchases_products {
  id         String  @id @default(uuid())
  purchaseId String?
  productId  String?

  pruchase purchases? @relation(references: [id], fields: [purchaseId])
  product  products?  @relation(references: [id], fields: [productId])
}

model invoices {
  id                  String               @id @default(uuid())
  client              users                @relation(fields: [clientId], references: [id])
  clientId            String
  payment_method      payment_method_Types @default(PAYPAL)
  payment_status      paymentTypes         @default(NOT_COMPLETED)
  payment_transaccion String               @db.Text

  expiration DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoices_products invoices_products[]
  invoices_charges  invoices_charges[]
}

model invoices_charges {
  id         String       @id @default(uuid())
  type       chargesTypes @default(OTHER)
  amount     Float
  invoicesId String
  invoices   invoices     @relation(references: [id], fields: [invoicesId])
}

model invoices_products {
  id String @id @default(uuid())

  name        String?
  description String?
  price       Float?

  invoicesId        String?
  productId         String?
  serviceId         String?
  servicecontractId String?

  product         products?          @relation(references: [id], fields: [productId])
  service         services?          @relation(references: [id], fields: [serviceId])
  servicecontract service_contracts? @relation(references: [id], fields: [servicecontractId])
  invoices        invoices?          @relation(fields: [invoicesId], references: [id])
}

model budgets {
  id              String            @id @default(uuid())
  client          users             @relation(fields: [clientId], references: [id])
  clientId        String
  description     String
  createdAT       DateTime          @default(now())
  updatedAT       DateTime          @updatedAt
  budget_products budget_products[]
}

model budget_products {
  id          String    @id @default(uuid())
  title       String?
  description String?   @db.Text
  price       Float?    @default(0)
  budget      budgets   @relation(fields: [budgetId], references: [id])
  product     products? @relation(fields: [productId], references: [id])
  budgetId    String
  productId   String?
}

model permissions {
  id               String             @id @default(uuid())
  name             permissionTypes    @unique
  description      String?
  user_permissions user_permissions[]
}

model user_permissions {
  id           String      @id @default(uuid())
  user         users       @relation(fields: [userId], references: [id])
  userId       String
  permission   permissions @relation(fields: [permissionId], references: [id])
  permissionId String
}

// services
model services {
  id          String @id @default(uuid())
  name        String
  description String
  price       Float
  photo       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service_contracts service_contracts[]
  invoices_products invoices_products[]
}

model service_contracts {
  id        String  @id @default(uuid())
  serviceId String?
  clientId  String

  name        String?
  description String? @db.Text
  price       Float?
  notes       String? @db.Text

  status     statusTypes @default(PENDING)
  start_date DateTime
  end_date   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service           services?           @relation(references: [id], fields: [serviceId])
  services_worke    services_worke[]
  invoices_products invoices_products[]
}

model services_worke {
  id                String @id @default(uuid())
  servicecontractId String
  teamId            String

  servicecontract service_contracts @relation(references: [id], fields: [servicecontractId])
  team            users             @relation(references: [id], fields: [teamId])
}
