// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum productTypes {
  WEB
  FIVEM
  DISCORD_BOT
}

enum paymentTypes {
  Completed
  Pending
  Not_Completed
}

enum payment_method_Types {
  Paypal
  Stripe
  Crypto
}

model users {
  id        String   @id @default(uuid())
  email     String
  password  String
  createdAt DateTime @default(now())

  userdetails   userDetails @relation(references: [id], fields: [userdetailsId])
  userdetailsId String      @unique
  purchases     purchases[]
  budgets       budgets[]

  @@index([email])
}

model userDetails {
  id        String @id @default(uuid())
  firstname String
  lastname  String
  nickname  String
  zipcode   String
  address   String
  phone     String

  user users?

  updatedAT DateTime @updatedAt
}

model products {
  id          String       @id @default(uuid())
  name        String
  description String       @db.Text
  price       Float
  photo       String
  type        productTypes @default(WEB)

  createdAt          DateTime             @default(now())
  updatedAT          DateTime             @updatedAt
  purchases_products purchases_products[]
  budget_products    budget_products[]
}

model purchases {
  id                 String               @id @default(uuid())
  user               users                @relation(fields: [userId], references: [id])
  userId             String
  payment_method     payment_method_Types @default(Paypal)
  payment_status     paymentTypes         @default(Not_Completed)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  purchases_products purchases_products[]
}

model purchases_products {
  id         String    @id @default(uuid())
  pruchase   purchases @relation(references: [id], fields: [purchaseId])
  product    products  @relation(references: [id], fields: [productId])
  purchaseId String
  productId  String
}

model budgets {
  id              String               @id @default(uuid())
  user            users                @relation(fields: [userId], references: [id])
  userId          String
  description     String
  total           Float
  payment_method  payment_method_Types @default(Paypal)
  payment_status  paymentTypes         @default(Not_Completed)
  createdAT       DateTime             @default(now())
  updatedAT       DateTime             @updatedAt
  budget_products budget_products[]
}

model budget_products {
  id          String   @id @default(uuid())
  title       String?
  description String?  @db.Text
  price       Float
  budget      budgets  @relation(fields: [budgetId], references: [id])
  product     products @relation(fields: [productId], references: [id])
  budgetId    String
  productId   String
}