generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum productTypes {
  WEB
  FIVEM
  DISCORD_BOT
}

enum paymentTypes {
  Completed
  Pending
  Not_Completed
}

enum payment_methodTypes {
  Paypal 
  Stripe
  Crypto
}
model users {
  id        String   @id @default(uuid())
  email     String
  password  String
  createdAt DateTime @default(now())

  userdetails   userDetails @relation(references: [id], fields: [userdetailsId])
  userdetailsId String      @unique
  purchases     purchases[]

  @@index([email])
}

model userDetails {
  id        String @id @default(uuid())
  firstname String
  lastname  String
  nickname  String
  zipcode   String
  address   String
  phone     String

  user users?

  updatedAT DateTime @updatedAt
}

model products {
  id          String       @id @default(uuid())
  name        String
  description String       @db.Text
  price       Float
  photo       String
  type        productTypes @default(WEB)

  createdAt          DateTime             @default(now())
  updatedAT          DateTime             @updatedAt
  purchases_products purchases_products[]
}

model purchases {
  id     String @id @default(uuid())
  user   users  @relation(fields: [userId], references: [id])
  userId String

  createdAt          DateTime             @default(now())
  purchases_products purchases_products[]
}

model purchases_products {
  id         String    @id @default(uuid())
  pruchase   purchases @relation(references: [id], fields: [purchaseId])
  product    products  @relation(references: [id], fields: [productId])
  purchaseId String
  productId  String
}


// TODO: agregar el tema de presupuesto y facturas
model bills {
  id     String @id @default(uuid())
  //bills_id String
  amount Float 
  payment_date DateTime  @default(now())
  payment_method payment_methodTypes @default(Paypal)
  payment_status paymentTypes @default(Not_Completed)       
}