// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum productTypes {
  WEB
  FIVEM
  DISCORD_BOT
}

enum paymentTypes {
  COMPLETED
  PENDING
  NOT_COMPLETED
  CANCELED
}

enum payment_method_Types {
  PAYPAL
  STRIPE
  CRYPTO
}

enum role {
  USER
  TEAM
  ADMIN
  OWN
}

enum permissionTypes {
  CREATE_USER
  READ_USER
  UPDATE_USER
  DELETE_USER
  READ_USER_DETAILS
  UPDATE_USER_DETAILS
  CREATE_PRODUCT
  READ_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  CREATE_PURCHASE
  READ_PURCHASE
  UPDATE_PURCHASE
  DELETE_PURCHASE
  CREATE_INVOICE
  READ_INVOICE
  UPDATE_INVOICE
  DELETE_INVOICE
  CREATE_BUDGET
  READ_BUDGET
  UPDATE_BUDGET
  DELETE_BUDGET
  READ_ADMIN_PANEL
  UPDATE_SETTINGS
  VIEW_REPORTS
  EXPORT_DATA
  ASSIGN_ROLE
  VIEW_ACTIVITY_LOG
  ALL_PERMISSION
}

model users {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  role      role     @default(USER)

  userdetails      userDetails?       @relation(references: [id], fields: [userdetailsId])
  userdetailsId    String?            @unique
  purchases        purchases[]
  budgets          budgets[]
  user_permissions user_permissions[]

  @@index([email])
}

model userDetails {
  id        String @id @default(uuid())
  firstname String
  lastname  String
  nickname  String
  zipcode   String
  address   String
  phone     String

  user users?

  updatedAT DateTime @updatedAt
}

model products {
  id          String       @id @default(uuid())
  name        String
  description String       @db.Text
  price       Float
  photo       String
  type        productTypes @default(WEB)

  createdAt          DateTime             @default(now())
  updatedAT          DateTime             @updatedAt
  purchases_products purchases_products[]
  budget_products    budget_products[]
}

model purchases {
  id             String               @id @default(uuid())
  user           users                @relation(fields: [userId], references: [id])
  userId         String
  payment_method payment_method_Types @default(PAYPAL)
  payment_status paymentTypes         @default(NOT_COMPLETED)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  purchases_products purchases_products[]
}

model purchases_products {
  id         String    @id @default(uuid())
  pruchase   purchases @relation(references: [id], fields: [purchaseId])
  product    products  @relation(references: [id], fields: [productId])
  purchaseId String
  productId  String
}

model budgets {
  id              String               @id @default(uuid())
  user            users                @relation(fields: [userId], references: [id])
  userId          String
  description     String
  total           Float?
  payment_method  payment_method_Types @default(PAYPAL)
  payment_status  paymentTypes         @default(NOT_COMPLETED)
  createdAT       DateTime             @default(now())
  updatedAT       DateTime             @updatedAt
  budget_products budget_products[]
}

model budget_products {
  id          String    @id @default(uuid())
  title       String?
  description String?   @db.Text
  price       Float?    @default(0)
  budget      budgets   @relation(fields: [budgetId], references: [id])
  product     products? @relation(fields: [productId], references: [id])
  budgetId    String
  productId   String?
}

model permissions {
  id               String             @id @default(uuid())
  name             permissionTypes    @unique
  description      String?
  user_permissions user_permissions[]
}

model user_permissions {
  id           String      @id @default(uuid())
  user         users       @relation(fields: [userId], references: [id])
  userId       String
  permission   permissions @relation(fields: [permissionId], references: [id])
  permissionId String
}
