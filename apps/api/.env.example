# Sacala de: Supabase Dashboard -> Financeapi -> Project Settings -> Database
# -> Connection string -> URI (Transaction pooler, puerto 6543)
# Usada en runtime por la app (soporta muchas conexiones concurrentes cortas).
DATABASE_URL="postgresql://postgres.kzjyozmrhpvgmfdtbeoy:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Misma base, pero conexión directa (puerto 5432, sin pgbouncer). Requerida
# por `prisma migrate`/`db seed`: el pooler en modo transaction no soporta los
# advisory locks ni prepared statements que Prisma migrate necesita — sin esto
# los comandos de migración se cuelgan sin dar error.
DIRECT_URL="postgresql://postgres.kzjyozmrhpvgmfdtbeoy:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
PORT=5050
# development = logs con pino-pretty (legible en consola)
# production  = logs en JSON crudo (lo que espera un agregador de logs real)
NODE_ENV="development"

# Usadas solo por `npx prisma db seed` para crear el primer usuario OWNER en
# una base nueva. Sin esto, ninguna ruta @Roles('ADMIN', 'OWNER') es
# alcanzable sin editar la base a mano.
SEED_OWNER_EMAIL="owner@financeapi.local"
SEED_OWNER_PASSWORD="replace-with-a-strong-password"
